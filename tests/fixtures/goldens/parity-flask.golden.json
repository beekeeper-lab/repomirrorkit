      "name": "create without auth",
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "headers": {},
        "json": {
          "customer": "Ada",
          "category_id": 1
        }
      },
      "response": {
        "status": 401,
        "json": {
          "error": "unauthorized"
        }
      }
    },
