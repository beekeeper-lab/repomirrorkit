      "name": "health",
      "request": {
        "method": "GET",
        "path": "/api/health",
        "headers": {}
      },
      "response": {
        "status": 200,
        "json": {
          "status": "ok"
        }
      }
    },
    {
      "name": "categories (seeded lookup)",
      "request": {
        "method": "GET",
        "path": "/api/categories",
        "headers": {}
      },
      "response": {
        "status": 200,
        "json": [
          {
            "id": 1,
            "name": "books"
          },
          {
            "id": 2,
            "name": "games"
          },
          {
            "id": 3,
            "name": "music"
          }
        ]
      }
    },
